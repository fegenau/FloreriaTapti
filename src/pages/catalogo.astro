---
import Layout from "../components/Layout.astro";
import catalogData from "../data/catalog.json";
import { slugify } from "../utils/slugify.js";

const products = catalogData.flowers as any[];
const categories = [...new Set(products.map((p: any) => p.category).filter(Boolean))] as string[];

function getStartingPrice(product: any): number | null {
  if (product.isQuote) return null;
  const prices: number[] = Object.values(product.sizes as Record<string, any>)
    .filter((s): s is { total: number } => s !== null)
    .map((s: any) => s.total);
  return prices.length > 0 ? Math.min(...prices) : null;
}

const maxCatalogPrice = products.reduce((max: number, p: any) => {
  if (p.isQuote) return max;
  const prices: number[] = Object.values(p.sizes as Record<string, any>)
    .filter((s: any) => s !== null)
    .map((s: any) => s.total as number);
  return prices.length > 0 ? Math.max(max, ...prices) : max;
}, 0);
---

<Layout title="Catálogo | Tapti">
  <div class="min-h-screen pt-24 pb-16">

    <!-- Top bar -->
    <div class="border-b border-white/10 mb-6">
      <div class="max-w-screen-xl mx-auto px-6 py-3 flex items-center relative">

        <!-- Filter toggle -->
        <button id="toggle-sidebar"
          class="flex items-center gap-1.5 text-white/60 hover:text-white transition-colors text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="14" y2="12"/>
            <line x1="4" y1="18" x2="10" y2="18"/>
          </svg>
          <span>Filtro</span>
          <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        <!-- Product count (centrado) -->
        <span id="product-count"
          class="absolute left-1/2 -translate-x-1/2 text-sm text-white/50 pointer-events-none">
          {products.length} productos
        </span>

        <!-- Sort -->
        <div class="ml-auto relative">
          <button id="sort-toggle"
            class="flex items-center gap-1 text-sm text-white/60 hover:text-white transition-colors">
            <span id="sort-label">Más vendidos</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div id="sort-dropdown"
            class="hidden absolute right-0 top-full mt-2 bg-steel-800 border border-white/10 rounded-lg shadow-2xl z-50 w-52 py-1">
            <button class="sort-option block w-full text-left px-4 py-2 text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors" data-sort="default">Más vendidos</button>
            <button class="sort-option block w-full text-left px-4 py-2 text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors" data-sort="price-asc">Precio: menor a mayor</button>
            <button class="sort-option block w-full text-left px-4 py-2 text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors" data-sort="price-desc">Precio: mayor a menor</button>
            <button class="sort-option block w-full text-left px-4 py-2 text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors" data-sort="name">Nombre A-Z</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="max-w-screen-xl mx-auto px-6 flex gap-10">

      <!-- Sidebar -->
      <aside id="sidebar"
        class="w-52 flex-shrink-0 hidden lg:block sticky top-28 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pr-2">

        <!-- Categoría -->
        <div class="mb-8">
          <button id="toggle-cat" class="w-full flex items-center justify-between mb-4">
            <span class="text-sm font-semibold text-white tracking-wide">Categoría</span>
            <svg id="cat-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"
              class="text-white/40 transition-transform duration-200">
              <polyline points="18 15 12 9 6 15"/>
            </svg>
          </button>
          <div id="cat-list" class="space-y-2.5">
            {categories.map(cat => (
              <label class="flex items-center gap-2.5 cursor-pointer group">
                <input type="checkbox" class="category-filter w-3.5 h-3.5 rounded-sm border border-white/30 bg-white/5 cursor-pointer accent-brand-400" value={cat} />
                <span class="text-sm text-white/55 group-hover:text-white/90 transition-colors leading-tight">{cat}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Precio -->
        <div class="mb-8">
          <button id="toggle-price" class="w-full flex items-center justify-between mb-4">
            <span class="text-sm font-semibold text-white tracking-wide">Precio</span>
            <svg id="price-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"
              class="text-white/40 transition-transform duration-200">
              <polyline points="18 15 12 9 6 15"/>
            </svg>
          </button>
          <div id="price-list">
            <!-- Min/Max inputs -->
            <div class="flex gap-2 mb-4">
              <div class="flex-1 bg-white/5 border border-white/15 rounded px-2 py-1.5 flex items-center gap-0.5 min-w-0">
                <span class="text-white/35 text-xs flex-shrink-0">$</span>
                <input type="number" id="price-min-input" value="0"
                  class="w-full bg-transparent text-white text-xs focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none min-w-0" />
              </div>
              <div class="flex-1 bg-white/5 border border-white/15 rounded px-2 py-1.5 flex items-center gap-0.5 min-w-0">
                <span class="text-white/35 text-xs flex-shrink-0">$</span>
                <input type="number" id="price-max-input" value={maxCatalogPrice}
                  class="w-full bg-transparent text-white text-xs focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none min-w-0" />
              </div>
            </div>
            <!-- Dual range slider -->
            <div id="price-slider-wrap" class="relative h-5" data-max={maxCatalogPrice}>
              <div class="absolute top-1/2 -translate-y-1/2 w-full h-[3px] bg-white/15 rounded-full">
                <div id="range-fill" class="absolute h-full bg-brand-400 rounded-full" style="left:0%;right:0%"></div>
              </div>
              <input type="range" id="price-range-min" class="price-range"
                min="0" max={maxCatalogPrice} value="0" step="1000" />
              <input type="range" id="price-range-max" class="price-range"
                min="0" max={maxCatalogPrice} value={maxCatalogPrice} step="1000" />
            </div>
          </div>
        </div>
      </aside>

      <!-- Grid -->
      <main class="flex-1 min-w-0">
        <div id="catalog-grid"
          class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-5 gap-y-10">
          {products.map((product: any) => {
            const startingPrice = getStartingPrice(product);
            const slug = slugify(product.name);
            return (
              <a
                href={`/producto/${slug}`}
                class="catalog-item group block"
                data-category={product.category || ''}
                data-price={startingPrice ?? 0}
                data-name={product.name.toLowerCase()}
              >
                <!-- Image carousel -->
                <div
                  class="relative aspect-square overflow-hidden rounded-sm bg-white/5 group/carousel"
                  data-images={JSON.stringify(
                    product.image.length > 1
                      ? product.image
                      : [product.image[0], product.image[0]]
                  )}
                >
                  <div class="carousel-track flex h-full transition-transform duration-700 ease-in-out">
                    <img
                      src={product.image[0]}
                      alt={product.name}
                      class="w-full h-full object-cover flex-shrink-0"
                      loading="lazy"
                    />
                    <img
                      src={product.image[1] || product.image[0]}
                      alt={`${product.name} 2`}
                      class="w-full h-full object-cover flex-shrink-0"
                      loading="lazy"
                    />
                  </div>
                  <!-- Dots indicator -->
                  <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1 opacity-0 group-hover/carousel:opacity-100 transition-opacity pointer-events-none">
                    <div class="w-1.5 h-1.5 rounded-full bg-white shadow"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-white/40 shadow"></div>
                  </div>
                </div>
                <!-- Info -->
                <div class="mt-2.5 px-0.5">
                  <p class="text-sm text-white/80 leading-snug">{product.name}</p>
                  {startingPrice != null ? (
                    <p class="text-sm text-white/45 mt-0.5">
                      ${startingPrice.toLocaleString('es-CL')}
                    </p>
                  ) : (
                    <p class="text-sm text-brand-400 mt-0.5">{product.price_range || 'Cotizar'}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>

        <p id="no-results" class="hidden text-center py-24 text-white/30 text-sm">
          No hay productos que coincidan con los filtros.
        </p>
      </main>
    </div>
  </div>
</Layout>

<style>
  input[type='range'].price-range {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: transparent;
    pointer-events: none;
    margin: 0;
    padding: 0;
  }
  input[type='range'].price-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    pointer-events: all;
    width: 15px;
    height: 15px;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  input[type='range'].price-range::-moz-range-thumb {
    pointer-events: all;
    width: 15px;
    height: 15px;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    border: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {

    // --- Sidebar toggle ---
    const sidebar = document.getElementById('sidebar');
    const toggleIcon = document.getElementById('toggle-icon');
    let sidebarOpen = window.innerWidth >= 1024;

    document.getElementById('toggle-sidebar')?.addEventListener('click', () => {
      sidebarOpen = !sidebarOpen;
      sidebar?.classList.toggle('hidden', !sidebarOpen);
      toggleIcon?.classList.toggle('rotate-180', !sidebarOpen);
    });

    // --- Price range dual slider ---
    const wrap = document.getElementById('price-slider-wrap');
    const maxPrice = parseInt(wrap?.dataset.max || '0');
    const rMin = document.getElementById('price-range-min') as HTMLInputElement;
    const rMax = document.getElementById('price-range-max') as HTMLInputElement;
    const iMin = document.getElementById('price-min-input') as HTMLInputElement;
    const iMax = document.getElementById('price-max-input') as HTMLInputElement;
    const fill = document.getElementById('range-fill');

    function updateFill() {
      if (!fill || !rMin || !rMax || maxPrice === 0) return;
      const lo = parseInt(rMin.value);
      const hi = parseInt(rMax.value);
      fill.style.left = ((lo / maxPrice) * 100) + '%';
      fill.style.right = (((maxPrice - hi) / maxPrice) * 100) + '%';
    }

    // --- Filter ---
    const grid = document.getElementById('catalog-grid');
    const countEl = document.getElementById('product-count');
    const noResults = document.getElementById('no-results');

    function applyFilters() {
      const selected = Array.from(
        document.querySelectorAll<HTMLInputElement>('.category-filter:checked')
      ).map(cb => cb.value);

      const lo = parseInt(rMin?.value || '0');
      const hi = parseInt(rMax?.value || maxPrice.toString());

      let visible = 0;
      grid?.querySelectorAll<HTMLElement>('.catalog-item').forEach(item => {
        const cat = item.dataset.category || '';
        const price = parseInt(item.dataset.price || '0');
        const isQuote = price === 0;

        const catOk = selected.length === 0 || selected.includes(cat);
        const priceOk = isQuote || (price >= lo && price <= hi);

        const show = catOk && priceOk;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countEl) countEl.textContent = `${visible} productos`;
      noResults?.classList.toggle('hidden', visible > 0);
    }

    document.querySelectorAll('.category-filter').forEach(cb =>
      cb.addEventListener('change', applyFilters)
    );

    rMin?.addEventListener('input', () => {
      if (parseInt(rMin.value) > parseInt(rMax.value)) rMin.value = rMax.value;
      if (iMin) iMin.value = rMin.value;
      updateFill();
      applyFilters();
    });

    rMax?.addEventListener('input', () => {
      if (parseInt(rMax.value) < parseInt(rMin.value)) rMax.value = rMin.value;
      if (iMax) iMax.value = rMax.value;
      updateFill();
      applyFilters();
    });

    iMin?.addEventListener('change', () => {
      if (rMin) { rMin.value = iMin.value; updateFill(); applyFilters(); }
    });
    iMax?.addEventListener('change', () => {
      if (rMax) { rMax.value = iMax.value; updateFill(); applyFilters(); }
    });

    // --- Sort ---
    const sortDropdown = document.getElementById('sort-dropdown');
    const sortLabel = document.getElementById('sort-label');

    document.getElementById('sort-toggle')?.addEventListener('click', e => {
      e.stopPropagation();
      sortDropdown?.classList.toggle('hidden');
    });
    document.addEventListener('click', () => sortDropdown?.classList.add('hidden'));

    document.querySelectorAll('.sort-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const sortType = (btn as HTMLElement).dataset.sort;
        if (sortLabel) sortLabel.textContent = btn.textContent?.trim() || '';
        sortDropdown?.classList.add('hidden');
        if (!grid) return;

        const items = Array.from(grid.querySelectorAll<HTMLElement>('.catalog-item'));
        items.sort((a, b) => {
          const pa = parseInt(a.dataset.price || '0');
          const pb = parseInt(b.dataset.price || '0');
          if (sortType === 'price-asc') return pa - pb;
          if (sortType === 'price-desc') return pb - pa;
          if (sortType === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          return 0;
        });
        items.forEach(item => grid.appendChild(item));
        applyFilters();
      });
    });

    // --- Collapsible sections ---
    function setupSection(btnId: string, listId: string, chevronId: string) {
      document.getElementById(btnId)?.addEventListener('click', () => {
        document.getElementById(listId)?.classList.toggle('hidden');
        document.getElementById(chevronId)?.classList.toggle('rotate-180');
      });
    }
    setupSection('toggle-cat', 'cat-list', 'cat-chevron');
    setupSection('toggle-price', 'price-list', 'price-chevron');

    // --- Carousel on hover ---
    document.querySelectorAll<HTMLElement>('.group\\/carousel').forEach(carousel => {
      const track = carousel.querySelector<HTMLElement>('.carousel-track');
      let timer: ReturnType<typeof setInterval>;

      carousel.addEventListener('mouseenter', () => {
        let idx = 0;
        timer = setInterval(() => {
          idx = idx === 0 ? 1 : 0;
          if (track) track.style.transform = `translateX(-${idx * 100}%)`;
        }, 2000);
      });

      carousel.addEventListener('mouseleave', () => {
        clearInterval(timer);
        if (track) track.style.transform = 'translateX(0)';
      });
    });

    updateFill();
  });
</script>
