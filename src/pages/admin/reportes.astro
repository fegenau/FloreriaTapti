---
import LayoutAdmin from "../../components/LayoutAdmin.astro";
import AdminReports from "../../components/AdminReports.astro";
import { getAuthUser, isAdminEmail } from "../../lib/auth";

// Verificar sesión a partir de la cookie de la request actual
const user = await getAuthUser(Astro.cookies);

// Redirigir si no está autenticado o no es administrador
if (!user || !isAdminEmail(user.email)) {
  return Astro.redirect('/login');
}
---

<LayoutAdmin title="Reportes | Tapti">
  <div class="min-h-screen bg-gradient-to-br from-rose-50 to-pink-50">
    <!-- Header -->
    <div class="border-b border-gray-200 bg-white shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-6 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-grafito">Administración</h1>
          <p class="text-gray-600 text-sm">Bienvenido, {user.email}</p>
        </div>
        <div class="flex gap-4">
          <a
            href="../../admin.astro"
            class="px-4 py-2 text-gray-700 hover:text-rose-500 transition"
          >
            Ver Catálogo
          </a>
          <a
            href="/api/auth/logout"
            class="px-4 py-2 bg-rose-500 text-white rounded-lg hover:bg-rose-600 transition"
          >
            Cerrar Sesión
          </a>
        </div>
      </div>
    </div>

    <!-- Contenido -->
    <div class="max-w-6xl mx-auto px-4 py-8">
      <AdminReports />
    </div>
  </div>
</LayoutAdmin>
