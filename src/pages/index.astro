---
import Layout from "../components/Layout.astro";
import BoutiqueCard from "../components/BoutiqueCard.astro";
import FloatingNav from "../components/FloatingNav.astro";
import OccasionCard from "../components/OccasionCard.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import { getCatalogData, resolveCatalogImageUrlSync } from "../lib/catalog";

// Servicios principales
const mainServices = [
  {
    title: "Ramos Personalizados",
    description: "Diseños únicos adaptados a tus gustos y ocasión especial",
    image: resolveCatalogImageUrlSync("/Flores/Armando.png"),
    url: "/contacto",
  },
  {
    title: "Eventos Especiales",
    description:
      "Bodas, cumpleaños y celebraciones con arreglos florales únicos",
    image:
      "https://.unsplash.com/photo-1519225421980-715cb0215aed?w=400&h=500&fit=crop&crop=center",
    url: "/contacto",
  },
  {
    title: "Experiencia Tapti",
    description: "Esto es más que un regalo, es una experiencia completa",
    image: resolveCatalogImageUrlSync("/Flores/Experiencia Tapti/Experiencia Tapti.avif"),
    url: "/catalogo",
  },
  {
    title: "Suscripciones Mensuales",
    description: "Esto es más que un regalo, es una experiencia completa",
    image: resolveCatalogImageUrlSync("/Flores/Jardin secreto/JardinSecreto1.avif"),
    url: "/suscripciones",
  },
];

const { flowers: catalogProducts } = await getCatalogData();

const categoryShowcase = [
  {
    title: "Ramos Mixtos",
    category: "Ramos Mixtos",
    description: "Combinaciones de flores variadas para cada ocasión",
  },
  {
    title: "Ramos Deluxe",
    category: "Ramos Deluxe",
    description: "Nuestra selección premium de ramos exclusivos",
    image: resolveCatalogImageUrlSync("/Flores/Bouquet Alquimia/BouquetAlquimia.avif"),
  },
  {
    title: "Condolencias",
    category: "Condolencias",
    description: "Arreglos para acompañar en momentos difíciles",
  },
  {
    title: "Nacimientos",
    category: "Nacimientos",
    description: "Canastos y detalles para dar la bienvenida al mundo",
  },
  {
    title: "Arreglos Florales",
    category: "Arreglos Florales",
    description: "Composiciones únicas para decorar cualquier espacio",
  },
  {
    title: "Aniversarios",
    category: "Aniversarios",
    description: "Regalos y experiencias para celebrar momentos especiales",
  },
].map((item) => {
  const match = catalogProducts.find(
    (f) => f.category === item.category,
  );
  return {
    ...item,
    image: item.image ?? match?.image?.[0] ?? "//Banner.jpg",
  };
});

const specialOccasions = [
  {
    title: "Rosas",
    image: resolveCatalogImageUrlSync("/Flores/Rosas rojas/Rosas rojas.avif"),
    url: "/catalogo?flor=Rosas",
  },
  {
    title: "Girasoles",
    image: resolveCatalogImageUrlSync("/Flores/Girasoles clasico/Ramo girasoles clásico.webp"),
    url: "/catalogo?flor=Girasoles",
  },
  {
    title: "Lilium",
    image: resolveCatalogImageUrlSync("/Flores/Condolencias.jpeg"),
    url: "/catalogo?flor=Lilium",
  },
  {
    title: "Tulipanes",
    image: resolveCatalogImageUrlSync("/Flores/Tulipanes/Tulipanes.jpeg"),
    url: "/catalogo?flor=Tulipanes",
  },
];
---

<Layout
  title="Tapti — Florería Moderna, elegante y auténtica"
  hideHeader={true}
  hideFooter={true}
  showEntrance={true}
>
  <!-- Eliminar padding del main para que las cards toquen los bordes -->
  <div class="min-h-screen pt-20 pb-24 space-y-6">
    <!-- Hero Card Principal -->
    <BoutiqueCard
      variant="hero"
      size="hero"
      background="//Banner.jpg"
      className="md-4 md:mx-6"
    >
      <div class="max-w-4xl pl-8 md:pl-16">
        <h1
          class="font-serif text-5xl md:text-7xl lg:text-8xl text-white mb-6 leading-tight"
        >
          Tengo algo para ti
        </h1>
        <p
          class="text-lg md:text-xl lg:text-2xl text-white/90 mb-8 leading-relaxed max-w-2xl"
        >
          Ramos elegantes y regalos personalizados, diseñados con la esencia
          única de Tapti
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/catalogo"
            class="px-10 py-5 bg-terracota text-white font-semibold rounded-full hover:bg-terracota-hover transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105 text-lg relative z-10"
          >
            Explorar Catálogo
          </a>
          <a
            href="/sobre"
            class="px-10 py-5 border-2 border-white text-white rounded-full hover:bg-white hover:text-azul-profundo transition-all duration-300 text-lg relative z-10"
          >
            Nuestra Historia
          </a>
        </div>
      </div>
    </BoutiqueCard>

    <!-- Productos Destacados - Ancho completo -->
    <div class="px-4 md:px-6">
      <div class="max-w-7xl mx-auto">
        <h2
          class="font-serif text-5xl bg-clip-padding-3 md:text-5xl text-azul-profundo mb-8 text-center"
        >
          Nuestros Ramos Favoritos
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            categoryShowcase.map((item) => (
              <BoutiqueCard
                variant="gallery"
                size="large"
                background={item.image}
                className="min-h-[400px] group cursor-pointer"
                onclick={`window.location.href='/catalogo?categoria=${encodeURIComponent(item.category)}'`}
              >
                <div class="space-y-4 relative z-10">
                  <h3 class="font-serif text-2xl md:text-3xl text-white mb-3 group-hover:text-sky-soft transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-white/85 mb-4 text-sm md:text-base line-clamp-3 group-hover:text-white transition-colors">
                    {item.description}
                  </p>
                  <a
                    href={`/catalogo?categoria=${encodeURIComponent(item.category)}`}
                    class="inline-flex items-center text-terracota hover:text-terracota-hover font-medium transition-colors group/link text-lg relative z-10"
                  >
                    Ver Detalles
                    <svg
                      class="ml-2 w-5 h-5 transform group-hover/link:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              </BoutiqueCard>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Ocasiones Especiales -->
    <div class="px-4 md:px-6">
      <div class="max-w-7xl mx-auto">
        <h2
          class="font-serif text-5xl md:text-5xl text-azul-profundo mb-8 text-center"
        >
          Nuestras Flores Favoritas
        </h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {
            specialOccasions.map((occasion) => (
              <OccasionCard
                title={occasion.title}
                image={occasion.image}
                url={occasion.url}
                className="aspect-[4/3]"
              />
            ))
          }
        </div>
      </div>
    </div>

    

    <!-- Servicios Principales - Cards Verticales usando datos -->
    <div class="px-4 md:px-6">
      <div class="max-w-7xl mx-auto">
        <h2
          class="font-serif text-5xl md:text-5xl text-azul-profundo mb-8 text-center"
        >
          Nuestros Servicios
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            mainServices.map((service) => (
              <BoutiqueCard
                variant="gallery"
                size="medium"
                background={service.image.replace(/ /g, "%20")}
              >
                <div class="p-6 text-center relative z-10">
                  <h3 class="font-serif text-xl text-white mb-3">
                    {service.title}
                  </h3>
                  <p class="text-white/85 text-sm mb-4">
                    {service.description}
                  </p>
                  <a
                    href={service.url}
                    class="inline-block px-6 py-2 bg-terracota text-white rounded-full text-sm font-medium hover:bg-terracota-hover transition-colors relative z-10"
                  >
                    {service.url.includes("catalogo")
                      ? "Ver Catálogo"
                      : service.url.includes("contacto")
                        ? "Contactar"
                        : "Ver Planes"}
                  </a>
                </div>
              </BoutiqueCard>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Feed de Instagram con scraping -->
    <InstagramFeed username="tapti_regalo" />

    <!-- Card de Membresías - Ancho ajustado y centrado (Oculto temporalmente) -->
    <div class="justify-center px-4 md:px-6 hidden">
      <div class="w-full max-w-5xl">
        <BoutiqueCard
          variant="services"
          size="medium"
          className="text-center py-16"
        >
          <h2
            class="font-serif text-3xl md:text-4xl lg:text-5xl text-honey-bronze-400 mb-6"
          >
            Únete a Tapti Club
          </h2>
          <p
            class="text-cherry-blossom-100 mb-8 max-w-3xl mx-auto text-lg md:text-xl leading-relaxed"
          >
            Descubre beneficios exclusivos, descuentos especiales y acceso
            prioritario a nuestras nuevas colecciones
          </p>
          <a
            href="/suscripciones"
            class="inline-flex items-center px-10 py-5 bg-gradient-to-r from-honey-bronze-500 to-honey-bronze-400 text-midnight-violet-950 font-semibold rounded-full hover:from-honey-bronze-400 hover:to-honey-bronze-300 transition-all duration-300 transform hover:scale-105 shadow-lg text-lg relative z-10"
          >
            Conocer Membresías
            <svg
              class="ml-3 w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </BoutiqueCard>
      </div>
    </div>
  </div>
  <!-- Navegación flotante -->
</Layout >

<!-- Navegación flotante -->
