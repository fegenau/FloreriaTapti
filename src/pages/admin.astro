---
import Layout from "../components/Layout.astro";
import AdminCatalog from "../components/AdminCatalog.astro";
import { supabase } from "../lib/supabase";

// Verificar sesión
const { data: { session } } = await supabase.auth.getSession();

// Redirigir si no está autenticado
if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="Administración de Catálogo | Tapti">
  <div class="min-h-screen bg-gradient-to-br from-rose-50 to-pink-50">
    <!-- Header -->
    <div class="border-b border-gray-200 bg-white shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-6 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-grafito">Administración</h1>
          <p class="text-gray-600 text-sm">Bienvenido, {session.user.email}</p>
        </div>
        <div class="flex gap-4">
          <a 
            href="/catalogo" 
            class="px-4 py-2 text-gray-700 hover:text-rose-500 transition"
          >
            Ver Catálogo
          </a>
          <a 
            href="/api/auth/logout" 
            class="px-4 py-2 bg-rose-500 text-white rounded-lg hover:bg-rose-600 transition"
          >
            Cerrar Sesión
          </a>
        </div>
      </div>
    </div>

    <!-- Contenido -->
    <div class="max-w-6xl mx-auto px-4 py-8">
      <AdminCatalog isAdmin={true} />
    </div>
  </div>
</Layout>
