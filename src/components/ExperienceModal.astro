---

---

<div
  id="experience-modal"
  class="fixed inset-0 z-[250] bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
>
  <div
    class="relative w-full max-w-2xl bg-steel-900 border border-brand-400/30 rounded-2xl shadow-2xl p-8 my-8 max-h-[90vh] overflow-y-auto"
  >
    <button
      id="close-experience-modal"
      class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors p-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line
          x1="6"
          y1="6"
          x2="18"
          y2="18"></line></svg
      >
    </button>

    <div class="text-center mb-8">
      <h2 class="font-serif text-3xl text-brand-300 mb-2">
        Personaliza tu Experiencia Tapti
      </h2>
      <p class="text-gray-400">
        Cuéntanos los detalles para crear tu momento perfecto al estilo
        Bridgerton.
      </p>
    </div>

    <form id="experience-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-100 mb-1"
            >Nombre Completo</label
          >
          <input
            type="text"
            name="name"
            required
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-100 mb-1"
            >Horario Específico</label
          >
          <input
            type="text"
            name="time"
            placeholder="Ej: 19:30 hrs"
            required
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-100 mb-1"
            >Email</label
          >
          <input
            type="email"
            name="email"
            required
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-100 mb-1"
            >Teléfono</label
          >
          <input
            type="tel"
            name="phone"
            required
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
            placeholder="+569..."
          />
        </div>
      </div>

      <div class="space-y-4">
        <label class="block text-sm font-medium text-brand-100 mb-1"
          >Dirección de la Experiencia</label
        >
        <input
          type="text"
          id="exp-address"
          name="address"
          required
          placeholder="Calle y número"
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
        />

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
          <input
            type="text"
            name="commune"
            required
            placeholder="Comuna"
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
          <input
            type="text"
            name="region"
            required
            placeholder="Región"
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
          <input
            type="text"
            name="zipcode"
            placeholder="Cód. Postal (opc)"
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-brand-100 mb-2"
          >Selecciona tu Bebestible</label
        >
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
          {
            ["Bebida", "Mistral Ice", "Vino", "Jugo Natural", "Agua"].map(
              (drink) => (
                <label class="relative flex items-center justify-center p-3 border border-white/10 rounded-lg cursor-pointer hover:bg-white/5 transition-all text-sm group">
                  <input
                    type="radio"
                    name="beverage"
                    value={drink}
                    required
                    class="peer absolute opacity-0"
                  />
                  <span class="text-gray-400 peer-checked:text-brand-300 transition-colors">
                    {drink}
                  </span>
                  <div class="absolute inset-0 border-2 border-transparent peer-checked:border-brand-400 rounded-lg pointer-events-none" />
                </label>
              ),
            )
          }
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-brand-100 mb-1"
          >Comentario Adicional</label
        >
        <textarea
          name="comment"
          rows="3"
          placeholder="Algo adicional que quieras incluir..."
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-4 bg-brand-400 hover:bg-brand-500 text-white font-bold rounded-full shadow-lg shadow-brand-400/20 transition-all transform hover:scale-[1.02] active:scale-95 text-lg"
      >
        Agregar Experiencia al Carrito
      </button>
    </form>
  </div>
</div>

<script>
  import { addCartItem } from "../store/cartStore";

  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("experience-modal");
    const closeBtn = document.getElementById("close-experience-modal");
    const form = document.getElementById("experience-form") as HTMLFormElement;
    const addressInput = document.getElementById(
      "exp-address",
    ) as HTMLInputElement;

    let currentProduct: any = null;
    let currentSize: string = "";
    let currentPrice: number = 0;

    // Listen for custom event to open modal
    window.addEventListener("open-experience-form", (e: any) => {
      const { product, size, price } = e.detail;
      currentProduct = product;
      currentSize = size;
      currentPrice = price;

      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      }
    });

    const closeModal = () => {
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
        form.reset();
      }
    };

    closeBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // Google Places Autocomplete for the experience address
    // @ts-ignore
    if (addressInput && typeof google !== "undefined") {
      // @ts-ignore
      const autocomplete = new google.maps.places.Autocomplete(addressInput, {
        componentRestrictions: { country: "cl" },
        fields: ["address_components", "geometry", "name"],
        types: ["address"],
      });
      addressInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") e.preventDefault();
      });
    }

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const metadata = Object.fromEntries(formData);

      if (currentProduct) {
        // @ts-ignore
        addCartItem(currentProduct, currentSize, currentPrice, metadata);

        // Visual feedback/success
        const originalText = form.querySelector("button")?.innerText;
        if (form.querySelector("button")) {
          form.querySelector("button")!.innerText = "¡Agregado!";
        }

        setTimeout(() => {
          closeModal();
          window.location.href = "/carrito";
        }, 800);
      }
    });
  });
</script>
