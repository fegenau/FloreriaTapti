---
import EntranceAnimation from "./EntranceAnimation.astro";
import FloatingNav from "./FloatingNav.astro";
import FloatingWhatsApp from "./FloatingWhatsApp.astro";
import AccessoriesModal from "./AccessoriesModal.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  showEntrance?: boolean;
  hideWhatsApp?: boolean;
}

const {
  title = "Tapti Flores y Regalos",
  hideHeader = false,
  hideFooter = false,
  showEntrance = false,
  hideWhatsApp = false,
} = Astro.props;
---

<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      // Run before first paint to prevent flash
      if (sessionStorage.getItem("tapti_intro_shown")) {
        document.documentElement.style.overflow = "visible";
        // Inject a style that makes main-content immediately visible
        var s = document.createElement("style");
        s.textContent =
          "#main-content { opacity: 1 !important; transition: none !important; animation: none !important; }";
        document.head.appendChild(s);
      }
    </script>
    <script
      is:inline
      src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.GOOGLE_MAPS_API_KEY}&libraries=places`}
    ></script>
  </head>
  <body
    class="min-h-screen text-white overflow-visible"
    style="background-color: #0B1220;"
  >
    {showEntrance && <EntranceAnimation />}

    <div
      id="main-content"
      class={showEntrance
        ? "opacity-0 transition-opacity duration-1000"
        : "opacity-100"}
    >
      <script is:inline>
        // Fallback for astro:page-load (View Transitions)
        document.addEventListener("astro:page-load", function () {
          if (sessionStorage.getItem("tapti_intro_shown")) {
            var main = document.getElementById("main-content");
            if (main) {
              main.style.opacity = "1";
              main.style.transition = "none";
              main.style.animation = "none";
            }
            document.body.style.overflow = "visible";
          }
        });
      </script>
      <FloatingNav />
      <main class={hideHeader ? "min-h-screen" : "min-h-[70vh]"}>
        <slot />
      </main>
      {
        !hideFooter && (
          <footer class="border-t border-white/10">
            <div class="max-w-6xl mx-auto px-4 py-8 text-sm flex items-center justify-between">
              <p>© {new Date().getFullYear()} Tapti Flores y Regalos</p>
              <a href="https://wa.me/56998133149" class="hover:text-tapti-gold">
                WhatsApp
              </a>
            </div>
          </footer>
        )
      }
    </div>

    <style>
      body {
        background-color: #0b1220;
        color: #f8fafc;
      }

      @keyframes gentle-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      #main-content {
        animation: gentle-fade 1s ease-out forwards;
      }
    </style>
    {!hideWhatsApp && <FloatingWhatsApp />}
    <AccessoriesModal />
  </body>
</html>
