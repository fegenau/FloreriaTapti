---
import { supabase } from '../lib/supabase';
import { CATALOG_IMAGES_BASE_URL } from '../lib/catalog';

interface Props {
  isAdmin?: boolean;
}

const { isAdmin = true } = Astro.props;
---

<div class="min-h-screen bg-gradient-to-br from-rose-50 to-pink-50 px-4 py-12">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h4 class="text-lg font-semibold text-grafito"><a href="/dashboard"> &larr; Atras </a></h4>
      <h1 class="text-3xl font-bold text-grafito mb-2">Administración de Catálogo</h1>
      <p class="text-grafito/60">Gestiona los productos de tu catálogo de flores</p>
    </div>

    <!-- Botones de Acción -->
    <div class="mb-8 flex gap-4">
      <button
        id="btn-nuevo"
        class="bg-rose-500 hover:bg-rose-600 text-white font-semibold py-2 px-6 rounded-lg transition duration-200"
      >
        + Nuevo Producto
      </button>
    </div>

    <!-- Tabla de Productos -->
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-grafito/10 border-b border-grafito/20">
            <tr>
              <th class="text-left px-6 py-4 text-sm font-semibold text-grafito">Nombre</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-grafito">Categoría</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-grafito">Precio</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-grafito">Estado</th>
              <th class="text-center px-6 py-4 text-sm font-semibold text-grafito">Acciones</th>
            </tr>
          </thead>
          <tbody id="catalog-body">
            <!-- Cargado dinámicamente -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Formulario -->
<div id="modal-formulario" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 px-4">
  <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="sticky top-0 bg-white border-b border-gray-200 p-6 flex justify-between items-center">
      <h2 id="modal-titulo" class="text-2xl font-bold text-grafito">Nuevo Producto</h2>
      <button id="btn-cerrar-modal" class="text-gray-400 hover:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <form id="form-producto" class="p-6 space-y-6">
      <input type="hidden" id="producto-id" />

      <!-- Nombre -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Nombre del Producto *
        </label>
        <input
          type="text"
          id="producto-nombre"
          required
          placeholder="Ej: Ramo de Rosas Rojas"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- Descripción -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Descripción
        </label>
        <textarea
          id="producto-descripcion"
          placeholder="Descripción del producto"
          rows="4"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- Categoría -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Categoría *
        </label>
        <input
          type="text"
          id="producto-categoria"
          required
          placeholder="Ej: Colección General"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- Precio Unitario -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Precio Unitario (CLP)
        </label>
        <input
          type="number"
          id="producto-unit-price"
          placeholder="Ej: 1000"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- Tipos de Flores -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Tipos de Flores (separados por coma)
        </label>
        <input
          type="text"
          id="producto-flower-type"
          placeholder="Ej: Rosas, Lirios, Tulipanes"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- Estado -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Estado
        </label>
        <select
          id="producto-disponible"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none"
        >
          <option value="true" selected>Disponible</option>
          <option value="false">No Disponible</option>
        </select>
        <p class="text-xs text-grafito/50 mt-1">Los productos "No Disponible" no se muestran en el catálogo público.</p>
      </div>

      <!-- Tallas y Precios (JSON) -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Tallas y Precios (JSON)
        </label>
        <textarea
          id="producto-sizes"
          placeholder='{"Pequeño": {"total": 26000, "stems": "12 varas"}, "Mediano": {"total": 40000, "stems": "20 varas"}}'
          rows="4"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none font-mono text-sm"
        />
      </div>

      <!-- Imágenes -->
      <div>
        <label class="block text-sm font-medium text-grafito mb-2">
          Imágenes del Producto
        </label>
        <div id="imagenes-preview" class="grid grid-cols-3 sm:grid-cols-4 gap-3 mb-3"></div>
        <label
          for="producto-imagenes-input"
          class="inline-flex items-center gap-2 px-4 py-2 border border-dashed border-gray-300 rounded-lg text-sm text-grafito/70 cursor-pointer hover:border-rose-400 hover:text-rose-500 transition"
        >
          <span id="imagenes-upload-label">+ Agregar imágenes</span>
        </label>
        <input
          type="file"
          id="producto-imagenes-input"
          accept="image/jpeg,image/png,image/webp,image/avif"
          multiple
          class="hidden"
        />
        <p class="text-xs text-grafito/50 mt-1">JPG, PNG, WEBP o AVIF. Máximo 5MB por imagen.</p>
      </div>

      <!-- Checkboxes -->
      <!-- <div class="grid grid-cols-2 gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="producto-has-form" class="w-4 h-4" />
          <span class="text-sm text-grafito">Tiene Formulario</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="producto-is-quote" class="w-4 h-4" />
          <span class="text-sm text-grafito">Requiere Cotización</span>
        </label>
      </div> -->

      <!-- Botones -->
      <div class="flex gap-4 pt-4 border-t">
        <button
          type="submit"
          class="flex-1 bg-rose-500 hover:bg-rose-600 text-white font-semibold py-2 px-4 rounded-lg transition"
        >
          Guardar Producto
        </button>
        <button
          type="button"
          id="btn-cancelar-modal"
          class="flex-1 bg-gray-300 hover:bg-gray-400 text-grafito font-semibold py-2 px-4 rounded-lg transition"
        >
          Cancelar
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ catalogImagesBaseUrl: CATALOG_IMAGES_BASE_URL }}>
  window.__CATALOG_IMAGES_BASE_URL__ = catalogImagesBaseUrl;
</script>

<script>
  const catalogImagesBaseUrl: string = (window as any).__CATALOG_IMAGES_BASE_URL__ || '';

  interface CatalogProduct {
    id: string;
    name: string;
    category: string;
    unit_price: number;
    created_at: string;
    images?: string[];
    [key: string]: any;
  }

  const modal = document.getElementById('modal-formulario');
  const form = document.getElementById('form-producto') as HTMLFormElement;
  const btnNuevo = document.getElementById('btn-nuevo');
  const btnCerrarModal = document.getElementById('btn-cerrar-modal');
  const btnCancelarModal = document.getElementById('btn-cancelar-modal');
  const catalogBody = document.getElementById('catalog-body');
  const modalTitulo = document.getElementById('modal-titulo');
  const productoIdInput = document.getElementById('producto-id') as HTMLInputElement;
  const imagenesInput = document.getElementById('producto-imagenes-input') as HTMLInputElement;
  const imagenesPreview = document.getElementById('imagenes-preview') as HTMLDivElement;
  const imagenesUploadLabel = document.getElementById('imagenes-upload-label') as HTMLSpanElement;
  const disponibleSelect = document.getElementById('producto-disponible') as HTMLSelectElement;
  let catalogProducts: CatalogProduct[] = [];
  let currentImages: string[] = [];

  const getField = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function imageUrl(relativePath: string): string {
    return `${catalogImagesBaseUrl}${relativePath.split('/').map(encodeURIComponent).join('/')}`;
  }

  function renderImagenesPreview() {
    imagenesPreview.innerHTML = currentImages.map((path, index) => `
      <div class="relative group">
        <img src="${imageUrl(path)}" class="w-full h-20 object-cover rounded-lg border border-gray-200" />
        <button
          type="button"
          class="btn-quitar-imagen absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs shadow hover:bg-red-600"
          data-index="${index}"
          title="Quitar imagen"
        >×</button>
      </div>
    `).join('');

    imagenesPreview.querySelectorAll('.btn-quitar-imagen').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.getAttribute('data-index'));
        currentImages.splice(index, 1);
        renderImagenesPreview();
      });
    });
  }

  async function subirImagenes(files: FileList) {
    const nombreInput = getField<HTMLInputElement>('producto-nombre');
    const productName = nombreInput?.value || 'producto';

    imagenesUploadLabel.textContent = 'Subiendo...';
    imagenesInput.disabled = true;

    try {
      for (const file of Array.from(files)) {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('productName', productName);

        const res = await fetch('/api/catalog/upload-image', {
          method: 'POST',
          body: formData,
        });
        const result = await res.json();

        if (res.ok) {
          currentImages.push(result.path);
          renderImagenesPreview();
        } else {
          alert(`Error al subir ${file.name}: ${result.message}`);
        }
      }
    } finally {
      imagenesUploadLabel.textContent = '+ Agregar imágenes';
      imagenesInput.disabled = false;
      imagenesInput.value = '';
    }
  }

  imagenesInput.addEventListener('change', () => {
    if (imagenesInput.files && imagenesInput.files.length > 0) {
      subirImagenes(imagenesInput.files);
    }
  });

  // Cargar productos
  async function cargarProductos() {
    try {
      const res = await fetch('/api/catalog');
      const { data } = await res.json();
      catalogProducts = Array.isArray(data) ? data : [];

      catalogBody!.innerHTML = catalogProducts.map((producto: CatalogProduct) => {
        const productKey = String(producto.id ?? producto.name ?? '');
        const disponible = producto.isAvailable !== false;
        return `
        <tr class="border-b border-gray-200 hover:bg-gray-50">
          <td class="px-6 py-4 text-sm text-grafito">${producto.name}</td>
          <td class="px-6 py-4 text-sm text-grafito/60">${producto.category}</td>
          <td class="px-6 py-4 text-sm text-grafito">$${producto.unit_price?.toLocaleString('es-CL') || 'N/A'}</td>
          <td class="px-6 py-4 text-sm">
            <span class="px-2 py-1 rounded-full text-xs font-semibold ${disponible ? 'bg-green-100 text-green-700' : 'bg-gray-200 text-gray-600'}">
              ${disponible ? 'Disponible' : 'No Disponible'}
            </span>
          </td>
          <td class="px-6 py-4 text-center">
            <button class="btn-editar text-blue-500 hover:text-blue-700 mr-4" data-id="${productKey}">
              Editar
            </button>
            <button class="btn-eliminar text-red-500 hover:text-red-700" data-id="${productKey}">
              Eliminar
            </button>
          </td>
        </tr>
      `;
      }).join('');

      // Asignar eventos a botones de edición y eliminación
      document.querySelectorAll('.btn-editar').forEach(btn => {
        btn.addEventListener('click', () => abrirFormulario(btn.getAttribute('data-id')));
      });

      document.querySelectorAll('.btn-eliminar').forEach(btn => {
        btn.addEventListener('click', () => eliminarProducto(btn.getAttribute('data-id')));
      });
    } catch (error) {
      console.error('Error al cargar productos:', error);
      alert('Error al cargar los productos');
    }
  }

  // Abrir formulario para editar
  async function abrirFormulario(id?: string | null) {
    const productId = String(id ?? '').trim();

    if (productId && productId !== 'null' && productId !== 'undefined') {
      try {
        const producto = catalogProducts.find((p: CatalogProduct) => String(p.id ?? p.name) === productId)
          || (await fetch('/api/catalog')
            .then((res) => res.json())
            .then(({ data }) => Array.isArray(data) ? data.find((p: CatalogProduct) => String(p.id ?? p.name) === productId) : null));

        if (producto) {
          const nombreInput = getField<HTMLInputElement>('producto-nombre');
          const descripcionInput = getField<HTMLTextAreaElement>('producto-descripcion');
          const categoriaInput = getField<HTMLInputElement>('producto-categoria');
          const precioInput = getField<HTMLInputElement>('producto-unit-price');
          const flowerTypeInput = getField<HTMLInputElement>('producto-flower-type');
          const sizesInput = getField<HTMLTextAreaElement>('producto-sizes');

          modalTitulo!.textContent = 'Editar Producto';
          productoIdInput.value = productId;

          if (nombreInput) nombreInput.value = producto.name || '';
          if (descripcionInput) descripcionInput.value = producto.Description || producto.description || '';
          if (categoriaInput) categoriaInput.value = producto.category || '';
          if (precioInput) precioInput.value = producto.unit_price != null ? String(producto.unit_price) : '';
          if (flowerTypeInput) flowerTypeInput.value = Array.isArray(producto.flowerType) ? producto.flowerType.join(', ') : '';
          if (sizesInput) sizesInput.value = producto.sizes ? JSON.stringify(producto.sizes, null, 2) : '';
          disponibleSelect.value = producto.isAvailable === false ? 'false' : 'true';

          currentImages = Array.isArray(producto.images) ? [...producto.images] : [];

          if (currentImages.length === 0 && producto.name) {
            try {
              const legacyRes = await fetch(`/api/catalog/legacy-images?name=${encodeURIComponent(producto.name)}`);
              const legacyResult = await legacyRes.json();
              if (legacyRes.ok && Array.isArray(legacyResult.images)) {
                currentImages = legacyResult.images;
              }
            } catch (error) {
              console.error('Error al cargar imágenes existentes:', error);
            }
          }

          renderImagenesPreview();

          modal!.classList.remove('hidden');
          return;
        }
      } catch (error) {
        console.error('Error al cargar producto:', error);
      }
    }

    modalTitulo!.textContent = 'Nuevo Producto';
    productoIdInput.value = '';
    form.reset();
    currentImages = [];
    renderImagenesPreview();
    modal!.classList.remove('hidden');
  }

  // Cerrar modal
  function cerrarModal() {
    modal!.classList.add('hidden');
    form.reset();
    currentImages = [];
    renderImagenesPreview();
  }

  // Guardar producto
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const id = productoIdInput.value;
    const nombreInput = getField<HTMLInputElement>('producto-nombre');
    const descripcionInput = getField<HTMLTextAreaElement>('producto-descripcion');
    const categoriaInput = getField<HTMLInputElement>('producto-categoria');
    const precioInput = getField<HTMLInputElement>('producto-unit-price');
    const flowerTypeInput = getField<HTMLInputElement>('producto-flower-type');
    const sizesInput = getField<HTMLTextAreaElement>('producto-sizes');

    const nombre = nombreInput?.value ?? '';
    const descripcion = descripcionInput?.value ?? '';
    const categoria = categoriaInput?.value ?? '';
    const unitPrice = precioInput ? parseInt(precioInput.value) || null : null;
    const flowerType = (flowerTypeInput?.value ?? '')
      .split(',')
      .map(f => f.trim())
      .filter(Boolean);
    const sizesJson = sizesInput?.value ?? '';
    const images: string[] = [...currentImages];
    const isAvailable = disponibleSelect.value !== 'false';
    const hasForm = false;
    const isQuote = false;

    let sizes = {};
    try {
      if (sizesJson.trim()) {
        sizes = JSON.parse(sizesJson);
      }
    } catch (error) {
      alert('Error en formato JSON de tallas y precios');
      return;
    }

    const payload = {
      name: nombre,
      description: descripcion,
      category: categoria,
      flower_type: flowerType,
      unit_price: unitPrice,
      currency: 'CLP',
      sizes,
      images,
      has_form: hasForm,
      is_quote: isQuote,
      is_available: isAvailable,
    };

    try {
      let res;
      if (id) {
        // Actualizar
        res = await fetch(`/api/catalog/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } else {
        // Crear
        res = await fetch('/api/catalog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      }

      const result = await res.json();

      if (res.ok) {
        alert(result.message);
        cerrarModal();
        cargarProductos();
      } else {
        alert('Error: ' + result.message);
      }
    } catch (error) {
      console.error('Error al guardar producto:', error);
      alert('Error al guardar el producto');
    }
  });

  // Eliminar producto
  async function eliminarProducto(id: string | null) {
    if (!id || !confirm('¿Estás seguro de que deseas eliminar este producto?')) return;

    try {
      const res = await fetch(`/api/catalog/${id}`, { method: 'DELETE' });
      const result = await res.json();

      if (res.ok) {
        alert(result.message);
        cargarProductos();
      } else {
        alert('Error: ' + result.message);
      }
    } catch (error) {
      console.error('Error al eliminar producto:', error);
      alert('Error al eliminar el producto');
    }
  }

  // Event Listeners
  btnNuevo!.addEventListener('click', () => abrirFormulario());
  btnCerrarModal!.addEventListener('click', cerrarModal);
  btnCancelarModal!.addEventListener('click', cerrarModal);

  // Cargar productos al iniciar
  cargarProductos();
</script>

<style>
  #modal-formulario:not(.hidden) {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
