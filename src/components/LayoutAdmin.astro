---
interface Props {
  title?: string;
}

const { title = 'Administración | Tapti' } = Astro.props;
---

<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-grafito antialiased">
    <slot />
  </body>
</html>
