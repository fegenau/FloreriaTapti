---
---

<div
  id="quote-modal"
  class="fixed inset-0 z-[300] flex items-center justify-center bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-500"
  aria-hidden="true"
>
  <div
    class="bg-steel-900 border border-brand-400/30 rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-transform duration-300 relative max-h-[90vh] overflow-y-auto"
  >
    <button
      id="close-quote-modal"
      class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors p-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="text-center mb-6">
      <h2 class="text-2xl font-serif text-honey-bronze-100 mb-2">
        Cotizar <span id="quote-product-name" class="text-white"></span>
      </h2>
      <p class="text-gray-300 text-sm">
        Déjanos tus datos para agendar una reunión y diseñar tu ramo soñado.
      </p>
    </div>

    <form id="quote-form" class="space-y-4">
      <input type="hidden" name="product_name" id="hidden-quote-product" />
      
      <div>
        <label class="block text-sm font-medium text-brand-100 mb-1">Nombre Completo</label>
        <input
          type="text"
          name="name"
          required
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          placeholder="Tu nombre"
        />
      </div>
      
      <div>
        <label class="block text-sm font-medium text-brand-100 mb-1">Teléfono</label>
        <input
          type="tel"
          name="phone"
          required
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          placeholder="+56 9 1234 5678"
        />
      </div>
      
      <div>
        <label class="block text-sm font-medium text-brand-100 mb-1">Email</label>
        <input
          type="email"
          name="email"
          required
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all"
          placeholder="correo@ejemplo.com"
        />
      </div>
      
      <div>
        <label class="block text-sm font-medium text-brand-100 mb-1">Fecha de Matrimonio</label>
        <input
          type="date"
          name="wedding_date"
          required
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white focus:border-brand-400 outline-none transition-all text-white/80"
        />
      </div>

      <button
        type="submit"
        class="w-full py-3 mt-4 bg-honey-bronze-500 hover:bg-honey-bronze-400 text-midnight-violet-950 font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02] active:scale-95 text-lg"
      >
        Enviar Solicitud
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("quote-modal");
    const closeBtn = document.getElementById("close-quote-modal");
    const form = document.getElementById("quote-form") as HTMLFormElement;
    const productNameSpan = document.getElementById("quote-product-name");
    const hiddenProductInput = document.getElementById("hidden-quote-product") as HTMLInputElement;

    // Abrir modal
    window.addEventListener("open-quote-modal", (e: any) => {
      const { productName } = e.detail;
      
      if (productNameSpan) productNameSpan.textContent = productName;
      if (hiddenProductInput) hiddenProductInput.value = productName;
      
      if (modal) {
        modal.classList.remove("opacity-0", "pointer-events-none");
        document.body.style.overflow = "hidden";
      }
    });

    const closeModal = () => {
      if (modal) {
        modal.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
        if (form) form.reset();
      }
    };

    closeBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const name = formData.get("name") as string;
      const phone = formData.get("phone") as string;
      const email = formData.get("email") as string;
      const date = formData.get("wedding_date") as string;
      const product = formData.get("product_name") as string;
      
      const message = `Hola Tapti, quiero cotizar un ${product}.\n\nMis datos:\nNombre: ${name}\nTeléfono: ${phone}\nEmail: ${email}\nFecha de matrimonio: ${date}`;
      const whatsappUrl = `https://wa.me/56998133149?text=${encodeURIComponent(message)}`;
      
      // Visual feedback/success
      const submitBtn = form.querySelector("button");
      const originalText = submitBtn?.innerText || "Enviar Solicitud";
      if (submitBtn) {
        submitBtn.innerText = "Procesando...";
        submitBtn.disabled = true;
      }

      try {
        // Enviar email vía API
        await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            email,
            phone,
            message: `Interés en cotizar: ${product}`,
            subject: `Cotización Ramo de Novia: ${product}`,
            weddingDate: date
          }),
        });

        if (submitBtn) submitBtn.innerText = "¡Casi listo!";
        
        setTimeout(() => {
          if (submitBtn) {
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
          }
          window.open(whatsappUrl, "_blank");
          closeModal();
        }, 800);
      } catch (error) {
        console.error("Error al enviar cotización:", error);
        if (submitBtn) {
          submitBtn.innerText = originalText;
          submitBtn.disabled = false;
        }
        // Abrir WhatsApp de todas formas como respaldo
        window.open(whatsappUrl, "_blank");
        closeModal();
      }
    });
  });
</script>
