---
// Navegación flotante moderna para reemplazar el navbar tradicional
interface Props {
  // Cuando hay sesión de administrador activa, MainMenu ya dibuja una barra
  // fija con la marca y el usuario: esta nav se ancla debajo de ella en vez
  // de flotar encima (lo que bloqueaba los botones de esa barra).
  hasAdminBar?: boolean;
}

import { isContestEnabled } from "../lib/banner";

const { hasAdminBar = false } = Astro.props;
const contestEnabled = await isContestEnabled();
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const mobileLinks = [
  { href: "/", label: "Inicio", icon: "🏠" },
  { href: "/catalogo", label: "Catálogo", icon: "🌸" },
  { href: "/sobre", label: "Sobre Tapti", icon: "🌿" },
  ...(contestEnabled ? [{ href: "/concurso", label: "Concurso", icon: "🎁" }] : []),
  { href: "/contacto", label: "Contacto", icon: "📞" },
  { href: "/carrito", label: "Carrito", icon: "🛒" },
];
---

<nav
  class:list={[
    "z-40 backdrop-blur-md rounded-full px-6 py-3 shadow-lg hidden md:block border border-borde-claro w-fit",
    hasAdminBar ? "relative mt-4 mx-auto" : "fixed top-6 left-1/2 -translate-x-1/2",
  ]}
  style="background-color: #FAF7F2;"
>
  <div class="flex items-center space-x-6">
    <!-- Logo -->
    <a href="/" class="hover:opacity-80 transition-opacity flex items-center">
      <img src="/images/logo-tapti.png" alt="Tapti" class="h-10 w-auto" />
    </a>

    <!-- Separador -->
    <div class="w-px h-6 bg-borde-claro"></div>

    <!-- Links de navegación -->
    <div class="flex items-center space-x-4">
      <a
        href="/catalogo"
        aria-current={isActive("/catalogo") ? "page" : undefined}
        class:list={[
          "text-sm transition-colors px-3 py-1 rounded-full",
          isActive("/catalogo")
            ? "text-terracota font-semibold bg-terracota/10"
            : "text-azul-profundo hover:text-terracota hover:bg-terracota/10",
        ]}
      >
        Catálogo
      </a>
      {
        /* <a
        href="/membresias"
        class="text-sm text-azul-profundo hover:text-terracota transition-colors px-3 py-1 rounded-full hover:bg-terracota/10"
      >
        Membresías
      </a> */
      }
      <a
        href="/sobre"
        aria-current={isActive("/sobre") ? "page" : undefined}
        class:list={[
          "text-sm transition-colors px-3 py-1 rounded-full",
          isActive("/sobre")
            ? "text-terracota font-semibold bg-terracota/10"
            : "text-azul-profundo hover:text-terracota hover:bg-terracota/10",
        ]}
      >
        Sobre
      </a>
      {contestEnabled && (
        <a
          href="/concurso"
          aria-current={isActive("/concurso") ? "page" : undefined}
          class:list={[
            "text-sm transition-colors px-3 py-1 rounded-full",
            isActive("/concurso")
              ? "text-terracota font-semibold bg-terracota/10"
              : "text-azul-profundo hover:text-terracota hover:bg-terracota/10",
          ]}
        >
          Concurso
        </a>
      )}
      <a
        href="/contacto"
        aria-current={isActive("/contacto") ? "page" : undefined}
        class:list={[
          "text-sm transition-colors px-3 py-1 rounded-full",
          isActive("/contacto")
            ? "text-terracota font-semibold bg-terracota/10"
            : "text-azul-profundo hover:text-terracota hover:bg-terracota/10",
        ]}
      >
        Contacto
      </a>

      <div class="w-px h-4 bg-borde-claro mx-2"></div>

      <a
        href="/carrito"
        id="cart-btn-desktop"
        aria-current={isActive("/carrito") ? "page" : undefined}
        class:list={[
          "transition-colors p-2 rounded-full relative",
          isActive("/carrito")
            ? "text-terracota bg-terracota/10"
            : "text-azul-profundo hover:text-terracota hover:bg-terracota/10",
        ]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path
            d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
          ></path>
        </svg>
        <span
          id="cart-count-desktop"
          class="absolute -top-1 -right-1 bg-terracota text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden"
          >0</span
        >
      </a>
    </div>
  </div>
</nav>

<script>
  import { cartItems } from "../store/cartStore";

  document.addEventListener("astro:page-load", () => {
    const desktopCount = document.getElementById("cart-count-desktop");
    const mobileCount = document.getElementById("cart-count-mobile");
    const cartBtnDesktop = document.getElementById("cart-btn-desktop");
    const cartBtnMobile = document.getElementById("cart-btn-mobile");

    let currentItemCount = 0;

    cartItems.subscribe((items) => {
      const count = Object.values(items).reduce(
        (acc: any, item: any) => acc + item.quantity,
        0,
      );

      currentItemCount = count as number;

      if (desktopCount) {
        desktopCount.innerText = currentItemCount.toString();
        if (currentItemCount > 0) desktopCount.classList.remove("hidden");
        else desktopCount.classList.add("hidden");
      }

      if (mobileCount) {
        mobileCount.innerText = currentItemCount.toString();
        if (currentItemCount > 0) mobileCount.classList.remove("hidden");
        else mobileCount.classList.add("hidden");
      }
    });

    // Modal de accesorios desactivado: el carrito navega directo a /carrito.
    // Cambiar a true para volver a activarlo.
    const ACCESSORIES_MODAL_ENABLED = false;

    function handleCartClick(e: Event) {
      if (!ACCESSORIES_MODAL_ENABLED) return;
      // Only show modal if we are NOT already on the cart page
      // and we have items in the cart
      if (currentItemCount > 0 && window.location.pathname !== "/carrito") {
        e.preventDefault();
        window.dispatchEvent(new Event("open-accessories-modal"));
      }
    }

    cartBtnDesktop?.addEventListener("click", handleCartClick);
    cartBtnMobile?.addEventListener("click", handleCartClick);
  });
</script>


<!-- Cabecera móvil: hamburguesa + logo + carrito. Se oculta al hacer scroll hacia abajo
     y reaparece al subir, para no tapar el contenido. Con sesión de admin va debajo de
     la barra de MainMenu (no fija). -->
<header
  id="mobile-header"
  data-fixed={hasAdminBar ? "0" : "1"}
  class:list={[
    "md:hidden z-40 transition-transform duration-300",
    hasAdminBar ? "relative" : "fixed top-0 left-0 right-0",
  ]}
>
  <div class="relative z-20 bg-marfil/95 backdrop-blur-md border-b border-borde-claro shadow-md px-4 h-16 grid grid-cols-[48px_1fr_48px] items-center">
    <button
      id="mobile-menu-btn"
      type="button"
      class="hamburger w-12 h-12 -ml-1 flex items-center justify-center rounded-full text-azul-profundo active:bg-terracota/10"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-box" aria-hidden="true">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </span>
    </button>

    <a href="/" class="justify-self-center hover:opacity-80 transition-opacity">
      <img src="/images/logo-tapti.png" alt="Tapti" class="h-10 w-auto" />
    </a>

    <a
      href="/carrito"
      id="cart-btn-mobile"
      aria-label="Carrito"
      aria-current={isActive("/carrito") ? "page" : undefined}
      class:list={[
        "relative w-12 h-12 -mr-1 justify-self-end flex items-center justify-center rounded-full transition-colors",
        isActive("/carrito") ? "text-terracota bg-terracota/10" : "text-azul-profundo active:bg-terracota/10",
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span
        id="cart-count-mobile"
        class="absolute top-1.5 right-1.5 bg-terracota text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden"
        >0</span
      >
    </a>
  </div>

  <!-- Fondo oscuro detrás del menú -->
  <div id="mobile-menu-backdrop" class="mobile-backdrop fixed inset-0 z-0 bg-azul-profundo/30"></div>

  <!-- Menú desplegable -->
  <nav
    id="mobile-menu"
    class="mobile-menu absolute left-0 right-0 top-full z-10 bg-marfil border-b border-borde-claro shadow-xl rounded-b-2xl"
    aria-label="Menú principal"
  >
    <ul class="px-4 py-3">
      {mobileLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "flex items-center gap-3 px-4 py-3.5 rounded-xl text-base transition-colors",
              isActive(link.href)
                ? "text-terracota font-semibold bg-terracota/10"
                : "text-azul-profundo active:bg-terracota/10",
            ]}
          >
            <span class="text-lg w-6 text-center" aria-hidden="true">{link.icon}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .hamburger-box {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }
  .hamburger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease,
      top 0.3s ease;
  }
  .hamburger-line:nth-child(1) { top: 0; }
  .hamburger-line:nth-child(2) { top: 7px; }
  .hamburger-line:nth-child(3) { top: 14px; }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) { top: 7px; transform: rotate(45deg); }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) { top: 7px; transform: rotate(-45deg); }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }
  .mobile-backdrop {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }
  #mobile-header.menu-open .mobile-menu,
  #mobile-header.menu-open .mobile-backdrop {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  #mobile-header.header-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line,
    .mobile-menu,
    .mobile-backdrop,
    #mobile-header {
      transition: none !important;
    }
  }
</style>

<script>
  // Menú hamburguesa móvil y ocultar la cabecera al hacer scroll hacia abajo.
  let scrollBound = false;
  let lastY = 0;

  function getHeader() {
    return document.getElementById("mobile-header");
  }

  function setMenu(open: boolean) {
    const header = getHeader();
    const btn = document.getElementById("mobile-menu-btn");
    if (!header || !btn) return;
    const wasOpen = header.classList.contains("menu-open");
    header.classList.toggle("menu-open", open);
    if (open) header.classList.remove("header-hidden");
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    // Solo tocar el overflow si cambia el estado (la animación de entrada también lo usa).
    if (open !== wasOpen) document.documentElement.style.overflow = open ? "hidden" : "";
  }

  document.addEventListener("astro:page-load", () => {
    setMenu(false);
    lastY = window.scrollY;

    document.getElementById("mobile-menu-btn")?.addEventListener("click", () => {
      setMenu(!getHeader()?.classList.contains("menu-open"));
    });
    document.getElementById("mobile-menu-backdrop")?.addEventListener("click", () => setMenu(false));
    document.querySelectorAll("#mobile-menu a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

    if (scrollBound) return;
    scrollBound = true;

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && getHeader()?.classList.contains("menu-open")) setMenu(false);
    });

    // Al pasar a escritorio, cerrar el menú para no dejar el scroll bloqueado.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setMenu(false);
    });

    window.addEventListener(
      "scroll",
      () => {
        const header = getHeader();
        // Con barra de admin la cabecera no es fija: no se oculta.
        if (!header || header.dataset.fixed !== "1" || header.classList.contains("menu-open")) return;
        const y = window.scrollY;
        if (Math.abs(y - lastY) < 8) return;
        header.classList.toggle("header-hidden", y > lastY && y > 80);
        lastY = y;
      },
      { passive: true },
    );
  });

  // Antes de cambiar de página (View Transitions) liberar el scroll.
  document.addEventListener("astro:before-swap", () => {
    document.documentElement.style.overflow = "";
  });
</script>
